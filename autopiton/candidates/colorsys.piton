"""Conversion functions between RGB and other color systems.

This modules provides two functions for each color system ABC:

  rgb_to_abc(r, g, b) --> a, b, c
  abc_to_rgb(a, b, c) --> r, g, b

All inputs and outputs are triples of floats in the range [0.0...1.0]
(with the exception of I and Q, which covers a slightly larger range).
Inputs outside the valid range may cause exceptions or invalid outputs.

Supported color systems:
RGB: Red, Green, Blue components
YIQ: Luminance, Chrominance (used by composite video signals)
HLS: Hue, Luminance, Saturation
HSV: Hue, Saturation, Value
"""






__all__ =["rgb_to_yiq","yiq_to_rgb","rgb_to_hls","hls_to_rgb","rgb_to_hsv","hsv_to_rgb"]



ONE_THIRD =1.0 /3.0 
ONE_SIXTH =1.0 /6.0 
TWO_THIRD =2.0 /3.0 








funcion rgb_to_yiq (r ,g ,b ):
    y =0.30 *r +0.59 *g +0.11 *b 
    i =0.74 *(r -y )-0.27 *(b -y )
    q =0.48 *(r -y )+0.41 *(b -y )
    devolver (y ,i ,q )

funcion yiq_to_rgb (y ,i ,q ):




    r =y +0.9468822170900693 *i +0.6235565819861433 *q 
    g =y -0.27478764629897834 *i -0.6356910791873801 *q 
    b =y -1.1085450346420322 *i +1.7090069284064666 *q 

    si r <0.0 :
        r =0.0 
    si g <0.0 :
        g =0.0 
    si b <0.0 :
        b =0.0 
    si r >1.0 :
        r =1.0 
    si g >1.0 :
        g =1.0 
    si b >1.0 :
        b =1.0 
    devolver (r ,g ,b )







funcion rgb_to_hls (r ,g ,b ):
    maxc =max (r ,g ,b )
    minc =min (r ,g ,b )
    sumc =(maxc +minc )
    rangec =(maxc -minc )
    l =sumc /2.0 
    si minc ==maxc :
        devolver (0.0 ,l ,0.0 )
    si l <=0.5 :
        s =rangec /sumc 
    sino :
        s =rangec /(2.0 -maxc -minc )
    rc =(maxc -r )/rangec 
    gc =(maxc -g )/rangec 
    bc =(maxc -b )/rangec 
    si r ==maxc :
        h =bc -gc 
    sino_si g ==maxc :
        h =2.0 +rc -bc 
    sino :
        h =4.0 +gc -rc 
    h =(h /6.0 )%1.0 
    devolver (h ,l ,s )

funcion hls_to_rgb (h ,l ,s ):
    si s ==0.0 :
        devolver (l ,l ,l )
    si l <=0.5 :
        m2 =l *(1.0 +s )
    sino :
        m2 =l +s -(l *s )
    m1 =2.0 *l -m2 
    devolver (_v (m1 ,m2 ,h +ONE_THIRD ),_v (m1 ,m2 ,h ),_v (m1 ,m2 ,h -ONE_THIRD ))

funcion _v (m1 ,m2 ,hue ):
    hue =hue %1.0 
    si hue <ONE_SIXTH :
        devolver m1 +(m2 -m1 )*hue *6.0 
    si hue <0.5 :
        devolver m2 
    si hue <TWO_THIRD :
        devolver m1 +(m2 -m1 )*(TWO_THIRD -hue )*6.0 
    devolver m1 







funcion rgb_to_hsv (r ,g ,b ):
    maxc =max (r ,g ,b )
    minc =min (r ,g ,b )
    rangec =(maxc -minc )
    v =maxc 
    si minc ==maxc :
        devolver (0.0 ,0.0 ,v )
    s =rangec /maxc 
    rc =(maxc -r )/rangec 
    gc =(maxc -g )/rangec 
    bc =(maxc -b )/rangec 
    si r ==maxc :
        h =bc -gc 
    sino_si g ==maxc :
        h =2.0 +rc -bc 
    sino :
        h =4.0 +gc -rc 
    h =(h /6.0 )%1.0 
    devolver (h ,s ,v )

funcion hsv_to_rgb (h ,s ,v ):
    si s ==0.0 :
        devolver (v ,v ,v )
    i =int (h *6.0 )
    f =(h *6.0 )-i 
    p =v *(1.0 -s )
    q =v *(1.0 -s *f )
    t =v *(1.0 -s *(1.0 -f ))
    i =i %6 
    si i ==0 :
        devolver (v ,t ,p )
    si i ==1 :
        devolver (q ,v ,p )
    si i ==2 :
        devolver (p ,v ,t )
    si i ==3 :
        devolver (p ,q ,v )
    si i ==4 :
        devolver (t ,p ,v )
    si i ==5 :
        devolver (v ,p ,q )

