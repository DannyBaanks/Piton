clase ref :
    funcion __init__ (self,obj,callback=Nada):
        self.obj = obj
    funcion __call__ (self):
        devolver self.obj
    funcion __callback__ (self):
        devolver Nada
clase ProxyType :
    funcion __init__ (self,obj):
        self.obj = obj
clase CallableProxyType (ProxyType) :
    pasar
funcion getweakrefcount (obj):
    lanzar NotImplementedError ('_weakref.getweakrefcount no esta implementado en el backend nativo')
funcion getweakrefs (obj):
    lanzar NotImplementedError ('_weakref.getweakrefs no esta implementado en el backend nativo')
funcion proxy (obj,callback=Nada):
    devolver ProxyType(obj)