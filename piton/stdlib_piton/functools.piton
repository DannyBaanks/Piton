funcion reduce (funcion ,iterable ,*inicial ) :
    acumulador = Nada
    primero = Verdadero
    para x en inicial :
        acumulador = x
        primero = Falso
    para x en iterable :
        si primero :
            acumulador = x
            primero = Falso
        sino :
            acumulador = funcion (acumulador ,x )
    devolver acumulador


funcion wraps (envuelta ) :
    funcion envoltorio (_fn_objetivo ) :
        _fn_objetivo.__name__ = envuelta.__name__
        _fn_objetivo.__qualname__ = envuelta.__qualname__
        devolver _fn_objetivo
    devolver envoltorio


funcion total_ordering (clase ) :
    # The native MIR lowering handles @functools.total_ordering by synthesizing
    # missing comparison methods. This function is a no-op at runtime.
    devolver clase


funcion partial (_fn_objetivo ,*args ) :
    # PARTIAL_V1: liga los argumentos iniciales y devuelve un callable que
    # los antepone a los que reciba.
    funcion envoltorio (x ,*rest ) :
        todos = []
        para a en args :
            todos.append (a )
        todos.append (x )
        para a en rest :
            todos.append (a )
        devolver _fn_objetivo (*todos )
    devolver envoltorio


desde collections importar namedtuple

_CacheInfo = namedtuple("CacheInfo", ("hits", "misses", "maxsize", "currsize"))


funcion _hacer_lru (_fn_objetivo ,maxsize ,typed ):
    # LRU_STATS_V1: contadores hits/misses en un dict (el backend nativo no
    # tiene `nonlocal`) y los atributos cache_info()/cache_clear() colgados
    # del propio envoltorio, como en CPython.
    cache = {}
    orden = []
    estado = [0, 0, maxsize]
    funcion envoltorio (*args ) :
        clave = args
        si clave en cache :
            estado [0] = estado [0] + 1
            # LRU_ORDER_V1: un hit mueve la clave al final (mas reciente),
            # de modo que al llenar el cache sale la clave menos reciente,
            # igual que functools.lru_cache de CPython.
            si estado [2] no es Nada y estado [2] > 0 :
                anteriores = lista(orden)
                orden.clear()
                para anterior en anteriores:
                    anterior = tupla(anterior)
                    si anterior != clave :
                        orden.append(anterior)
                orden.append(clave)
            devolver cache [clave ]
        estado [1] = estado [1] + 1
        todos = []
        para a en args :
            todos.append (a )
        r = _fn_objetivo (*todos )
        si estado [2] != 0 :
            si estado [2] no es Nada y estado [2] > 0 y longitud (orden ) >= estado [2] :
                viejo = tupla (orden.pop (0 ))
                si viejo en cache :
                    borrar cache [viejo ]
            cache [clave ] = r
            orden.append (clave )
        devolver r
    funcion cache_info ():
        si estado [2] es Nada :
            devolver _CacheInfo (estado [0] ,estado [1] ,estado [2] ,longitud (cache ))
        devolver _CacheInfo (estado [0] ,estado [1] ,estado [2] ,longitud (cache ))
    funcion cache_clear ():
        cache.clear ()
        orden.clear ()
        estado [0] = 0
        estado [1] = 0
    devolver _adjuntar_lru (envoltorio ,cache_info ,cache_clear )


funcion _adjuntar_lru (envoltorio ,info ,limpiar ):
    # Un nombre de funcion anidada se materializa en cada carga, asi que los
    # atributos se fijan sobre el valor que llega como parametro: la misma
    # instancia es la que se devuelve.
    envoltorio.cache_info = info
    envoltorio.cache_clear = limpiar
    devolver envoltorio


funcion lru_cache (maxsize =128 ,typed =Falso ):
    # Soporta @lru_cache(maxsize=None)/@lru_cache(maxsize=32) y @lru_cache
    # directo sobre funcion (maxsize callable -> defaults). Cache real:
    # dict clave=tupla(args); eviccion FIFO/LRU si maxsize es int > 0;
    # maxsize=0 no cachea; maxsize=None crece sin limite.
    si tiene_atr (maxsize ,'__call__') :
        _fn_objetivo = maxsize
        maxsize = 128
        devolver _hacer_lru (_fn_objetivo ,maxsize ,typed )
    si maxsize no es Nada y maxsize < 0 :
        maxsize = 0
    funcion decorador (_fn_objetivo ) :
        devolver _hacer_lru (_fn_objetivo ,maxsize ,typed )
    devolver decorador
