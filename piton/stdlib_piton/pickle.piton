HIGHEST_PROTOCOL = 4
DEFAULT_PROTOCOL = 3
clase PickleError (Exception) :
    pasar
clase PicklingError (PickleError) :
    pasar
clase UnpicklingError (PickleError) :
    pasar
clase Pickler :
    funcion __init__ (self,file,protocol=DEFAULT_PROTOCOL,fix_imports=Verdadero):
        self.file = file
        self.protocol = protocol
    funcion dump (self,obj):
        pasar
    funcion clear_memo (self):
        pasar
clase Unpickler :
    funcion __init__ (self,file,fix_imports=Verdadero,encoding="ASCII",errors="strict"):
        self.file = file
    funcion load (self):
        devolver Nada
    funcion find_class (self,module,name):
        devolver getattr(__import__(module),name)
funcion dump (obj,file,protocol=DEFAULT_PROTOCOL,fix_imports=Verdadero):
    p = Pickler(file,protocol)
    p.dump(obj)
funcion dumps (obj,protocol=DEFAULT_PROTOCOL,fix_imports=Verdadero):
    devolver b""
funcion load (file,fix_imports=Verdadero,encoding="ASCII",errors="strict"):
    u = Unpickler(file)
    devolver u.load()
funcion loads (bytes_obj,fix_imports=Verdadero,encoding="ASCII",errors="strict"):
    devolver Nada
MARK = 0
STOP = 1
POP = 2
POP_MARK = 3
DUP = 4