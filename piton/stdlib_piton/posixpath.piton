funcion getsize (p ):
    lanzar NotImplementedError ('posixpath.getsize no esta implementado en el backend nativo')


funcion expanduser (p ):
    lanzar NotImplementedError ('posixpath.expanduser no esta implementado en el backend nativo: no hay entorno')


funcion expandvars (p ):
    lanzar NotImplementedError ('posixpath.expandvars no esta implementado en el backend nativo: no hay entorno')


