I = 2
IGNORECASE = 2
L = 4
LOCALE = 4
M = 8
MULTILINE = 8
S = 16
DOTALL = 16
U = 32
UNICODE = 32
X = 64
VERBOSE = 64
DEBUG = 128
A = 256
ASCII = 256
T = 1
TEMPLATE = 1

clase error :
    pasar

funcion escape (s ):
    salida = s
    salida = salida.replace ('\\','\\\\')
    salida = salida.replace ('(','\\(')
    salida = salida.replace (')','\\)')
    salida = salida.replace ('[','\\[')
    salida = salida.replace (']','\\]')
    salida = salida.replace ('{','\\{')
    salida = salida.replace ('}','\\}')
    salida = salida.replace ('?','\\?')
    salida = salida.replace ('*','\\*')
    salida = salida.replace ('+','\\+')
    salida = salida.replace ('-','\\-')
    salida = salida.replace ('|','\\|')
    salida = salida.replace ('^','\\^')
    salida = salida.replace ('$','\\$')
    salida = salida.replace ('.','\\.')
    salida = salida.replace ('&','\\&')
    salida = salida.replace ('~','\\~')
    salida = salida.replace ('#','\\#')
    salida = salida.replace (' ','\\ ')
    salida = salida.replace ('\t','\\\t')
    salida = salida.replace ('\n','\\\n')
    salida = salida.replace ('\r','\\\r')
    salida = salida.replace ('\x0b','\\\x0b')
    salida = salida.replace ('\x0c','\\\x0c')
    devolver salida


