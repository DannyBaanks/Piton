# crc32/adler32 y las llamadas directas a compress/decompress se implementan en
# el backend nativo Linux x86_64 (STDLIB_NATIVE_V1). compress emite bloques
# DEFLATE almacenados; decompress lee bloques almacenados y Huffman.


funcion crc32 (datos ,valor =0 ):
    lanzar NotImplementedError ("zlib.crc32 solo se soporta como llamada directa en el backend nativo")


funcion adler32 (datos ,valor =1 ):
    lanzar NotImplementedError ("zlib.adler32 solo se soporta como llamada directa en el backend nativo")


funcion compress (data ,level =-1 ):
    lanzar NotImplementedError ("zlib.compress requiere una llamada directa en el backend nativo")


funcion decompress (data ):
    lanzar NotImplementedError ("zlib.decompress requiere una llamada directa en el backend nativo")


funcion compressobj (*args ,**kwargs ):
    lanzar NotImplementedError ("zlib.compressobj no esta implementado en el backend nativo")


funcion decompressobj (*args ,**kwargs ):
    lanzar NotImplementedError ("zlib.decompressobj no esta implementado en el backend nativo")
