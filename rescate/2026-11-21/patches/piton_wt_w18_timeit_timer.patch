+class TimeitSourceStatementKinds(unittest.TestCase):
+    """stmts that bind names inside the isolated source namespace."""
+
+    def test_for_loop_target_is_source_local(self):
+        _assert_matches(
+            self,
+            "desde timeit importar Timer\n"
+            "t = Timer('for i in range(3):\\n    x = i')\n"
+            "v = t.timeit(number=2)\n"
+            "imprimir(type(v).__name__, v >= 0)\n",
+        )
+
+    def test_while_loop_and_try_in_source(self):
+        _assert_matches(
+            self,
+            "desde timeit importar Timer\n"
+            "t = Timer('i = 0\\nwhile i < 3:\\n    i = i + 1')\n"
+            "v = t.timeit(number=2)\n"
+            "u = Timer(\"try:\\n    x = 1\\nexcept ValueError as e:\\n    x = 2\")\n"
+            "w = u.timeit(number=2)\n"
+            "imprimir(type(v).__name__, type(w).__name__)\n",
+        )
+
+    def test_comprehension_and_del_in_source(self):
+        _assert_matches(
+            self,
+            "desde timeit importar Timer\n"
+            "t = Timer('xs = [k for k in range(3)]\\ndel xs')\n"
+            "v = t.timeit(number=2)\n"
+            "imprimir(type(v).__name__)\n",
+        )
+
+    def test_for_target_does_not_leak_to_the_caller(self):
+        _assert_matches(
+            self,
+            "desde timeit importar Timer\n"
+            "t = Timer('for i in range(2):\\n    a = i')\n"
+            "t.timeit(number=2)\n"
+            "intentar:\n"
+            "    imprimir(i)\n"
+            "excepto NameError:\n"
+            "    imprimir('NameError')\n",
+        )
+
+
+class TimeitMeasureValueType(unittest.TestCase):
+    """The elapsed seconds cross function boundaries as a float."""
+
+    def test_elapsed_returned_from_a_function_is_a_float(self):
+        _assert_matches(
+            self,
+            "desde timeit importar Timer\n"
+            "funcion medir():\n"
+            "    t = Timer('a = 1')\n"
+            "    devolver t.timeit(number=3)\n"
+            "v = medir()\n"
+            "imprimir(type(v).__name__, v >= 0)\n",
+        )
+
+    def test_elapsed_returned_from_a_method_is_a_float(self):
+        _assert_matches(
+            self,
+            "desde timeit importar Timer\n"
+            "clase C:\n"
+            "    funcion medir(este):\n"
+            "        t = Timer('a = 1')\n"
+            "        devolver t.timeit(number=2)\n"
+            "c = C()\n"
+            "v = c.medir()\n"
+            "imprimir(type(v).__name__, v >= 0)\n",
+        )
+
+    def test_zero_and_negative_counts_return_a_float(self):
+        _assert_matches(
+            self,
+            "desde timeit importar Timer\n"
+            "t = Timer('a = 1')\n"
+            "cero = t.timeit(0)\n"
+            "negativo = t.timeit(-3)\n"
+            "imprimir(type(cero).__name__, type(negativo).__name__)\n",
+        )
+
+    def test_reassigning_a_literal_source_keeps_the_timer_measurable(self):
+        _assert_matches(
+            self,
+            "desde timeit importar Timer\n"
+            "t = Timer('a = 1')\n"
+            "t.stmt = 'b = 2'\n"
+            "v = t.timeit(number=2)\n"
+            "imprimir(type(v).__name__, v >= 0)\n",
+        )
+
+
 if __name__ == "__main__":
     unittest.main()
