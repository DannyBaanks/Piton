+funcion _cierre_clase (patron ,i ,m ):
+    # primer char puede ser ']' literal (o tras '^'); devuelve su indice o -1
+    j = i
+    si j < m y patron [j ] == '^' :
+        j = j + 1
+    si j < m y patron [j ] == ']' :
+        j = j + 1
+    mientras j < m :
+        c = patron [j ]
+        si c == '\\' :
+            j = j + 2
+            continuar
+        si c == ']' :
+            devolver j
+        j = j + 1
